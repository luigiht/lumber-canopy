# Supabase project (Settings > API). Leave empty to save games in the browser only (offline mode).
# The anon key is safe in the browser; never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the game once deployed (used for SEO links, the share card and sitemap).
NEXT_PUBLIC_SITE_URL=
